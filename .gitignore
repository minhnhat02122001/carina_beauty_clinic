# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# playwright mcp debug output
.playwright-mcp/

# claude code (personal overrides, not shared with the team)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# HubSpot config file
hubspot.config.yml

# resend integration skills — installed by `vercel integration add`, tracked by
# skills-lock.json. `.agents/` is fetched content and the `.claude/skills/`
# entries are absolute symlinks into it, so neither is portable across machines.
.agents/
.claude/skills/agent-email-inbox
.claude/skills/email-best-practices
.claude/skills/react-email
.claude/skills/resend
.claude/skills/resend-cli
